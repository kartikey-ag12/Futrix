generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  // Schema default = false → all EXISTING rows in DB automatically become false
  // when migration runs — existing users are NEVER forced into Xero onboarding.
  // The signup route explicitly sets this to true for NEW user accounts going forward.
  requiresXeroOnboarding Boolean @default(false)

  workspaces    WorkspaceMember[]
  accounts      Account[]
  sessions      Session[]
  refreshTokens RefreshToken[]
  adminAuditLogs AdminAuditLog[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  industry    String?
  email       String?
  country     String?
  description String?  @db.Text
  createdAt   DateTime @default(now())

  members      WorkspaceMember[]
  integrations Integration[]
  drivers      Driver[]
  forecasts    Forecast[]
  reports      Report[]
}

model WorkspaceMember {
  id          String @id @default(cuid())
  userId      String
  workspaceId String
  role        String @default("MEMBER") // ADMIN, MEMBER

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Integration {
  id           String  @id @default(cuid())
  workspaceId  String
  provider     String // "xero", "tally"
  accessToken  String? @db.Text
  refreshToken String? @db.Text
  expiresAt    Int?
  tenantId     String? // Xero specific tenant ID

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

// NextAuth specific tables for sessions and OAuth...
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  admin       User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
}

model Driver {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  type        String   // "freestyle" or "formula"
  value       String?  // Formula expression or raw value
  unit        String?
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Forecast {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  type        String
  data        Json?
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Report {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  type        String
  status      String   @default("draft") // "draft" or "published"
  pageCount   Int      @default(1)
  data        Json?
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
