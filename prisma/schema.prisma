generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String            @id @default(cuid())
  name                   String?
  email                  String?           @unique
  emailVerified          DateTime?
  image                  String?
  passwordHash           String?
  createdAt              DateTime          @default(now())
  requiresXeroOnboarding Boolean           @default(false)
  role                   Role              @default(USER)
  completedTours         String[]          @default([])
  accounts               Account[]
  adminAuditLogs         AdminAuditLog[]
  refreshTokens          RefreshToken[]
  sessions               Session[]
  workspaces             WorkspaceMember[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id            String            @id @default(cuid())
  name          String
  createdAt     DateTime          @default(now())
  country       String?
  description   String?
  email         String?
  industry      String?
  accountGroups AccountGroup[]
  driverGroups  DriverGroup[]
  drivers       Driver[]
  forecasts     Forecast[]
  integrations  Integration[]
  reports       Report[]
  members       WorkspaceMember[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("MEMBER")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Integration {
  id           String    @id @default(cuid())
  workspaceId  String
  provider     String
  accessToken  String?
  refreshToken String?
  expiresAt    Int?
  tenantId     String?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String
  createdAt   DateTime @default(now())
  metadata    Json?
  admin       User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
}

model Driver {
  id            String       @id @default(cuid())
  workspaceId   String
  name          String
  type          String
  value         String?
  unit          String?
  driverGroupId String?
  createdAt     DateTime     @default(now())
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group         DriverGroup? @relation(fields: [driverGroupId], references: [id], onDelete: SetNull)
}

model DriverGroup {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  drivers     Driver[]
}

model Forecast {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  type        String
  data        Json?
  createdAt   DateTime  @default(now())
  status      String    @default("draft")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Report {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  type        String
  status      String    @default("draft")
  pageCount   Int       @default(1)
  data        Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AccountGroup {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  accountIds  String[]
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}
